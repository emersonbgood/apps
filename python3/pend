import pygame
import numpy as np

# --- CONFIG ---
RES = 250                 
G, L1, L2, M1, M2 = 9.8, 1.0, 1.0, 1.0, 1.0
DT = 0.012                
MAX_TIME = 30.0

pygame.init()
# Total window size: Width = 500, Height = 250
WIDTH, HEIGHT = RES * 2, RES
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Left: Position | Right: Flip Fractal")

def init_sim(res):
    t = np.linspace(-np.pi, np.pi, res)
    th1, th2 = np.meshgrid(t, t)
    return th1.astype(np.float32), th2.astype(np.float32), \
           np.zeros_like(th1), np.zeros_like(th1), \
           np.zeros_like(th1), np.zeros_like(th1, dtype=bool)

theta1, theta2, w1, w2, flip_times, has_flipped = init_sim(RES)
sim_time = 0.0
clock = pygame.time.Clock()

running = True
while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT: running = False

    # --- PHYSICS ---
    s1, c1 = np.sin(theta1), np.cos(theta1)
    s2, c2 = np.sin(theta2), np.cos(theta2)
    s12, c12 = np.sin(theta1 - theta2), np.cos(theta1 - theta2)
    
    denom = (M1 + M2) * L1 - M2 * L1 * c12**2
    a1 = (M2*L1*w1**2*s12*c12 + M2*G*s2*c12 + M2*L2*w2**2*s12 - (M1+M2)*G*s1) / denom
    a2 = (-M2*L2*w2**2*s12*c12 + (M1+M2)*(G*s1*c12 - L1*w1**2*s12 - G*s2)) / (L2/L1 * denom)

    w1 += a1 * DT
    w2 += a2 * DT
    theta1 += w1 * DT
    theta2 += w2 * DT
    sim_time += DT

    # Flip Detection
    currently_flipping = (np.abs(theta2) > np.pi) & (~has_flipped)
    if np.any(currently_flipping):
        flip_times[currently_flipping] = sim_time
        has_flipped[currently_flipping] = True

    # --- RENDER ---
    # img_left/right are (250, 250, 3) where [0] is Y and [1] is X
    img_left = np.zeros((RES, RES, 3), dtype=np.uint8)
    hue = (((theta2 + np.pi) % (2*np.pi) / (2*np.pi)) * 255).astype(np.uint8)
    val = (((np.cos(theta1) + 1) / 2) * 255).astype(np.uint8)
    img_left[:,:,0], img_left[:,:,1], img_left[:,:,2] = hue, 255-hue, val

    img_right = np.zeros((RES, RES, 3), dtype=np.uint8)
    bright = (np.clip(1.0 - (flip_times / MAX_TIME), 0, 1) * 255).astype(np.uint8)
    bright[~has_flipped] = 0 
    img_right[:,:,0], img_right[:,:,2] = bright, bright 

    # CORRECT STACKING FOR PYGAME:
    # 1. Stack side-by-side along axis 1 (horizontal)
    full_img = np.concatenate((img_left, img_right), axis=1)
    
    # 2. Swap axes so (Y, X, C) becomes (X, Y, C) as Pygame requires
    final_surf = np.swapaxes(full_img, 0, 1)

    # 3. This will now perfectly match the (500, 250) surface
    pygame.surfarray.blit_array(screen, final_surf)
    pygame.display.flip()
    
    # SAFETY: Limits CPU usage to prevent power-off/freeze
    clock.tick(30) 

pygame.quit()

